# iTop MCP server configuration. Copy to .env and fill in the REQUIRED values.
# The container refuses to start when a required value is missing; `docker logs` names it.

# --- Required ---------------------------------------------------------------------------

# REQUIRED. Base URL of your iTop, without a trailing slash.
ITOP_BASE_URL=https://itop.example.com

# REQUIRED. Public URL of this MCP server, as MCP clients reach it through your reverse proxy.
# Must be identical to the `itop-mcp` resource configured for altioo-oauth-server in iTop.
MCP_RESOURCE_URL=https://mcp.example.com/mcp

# --- Optional ---------------------------------------------------------------------------

# OAuth issuer (altioo-oauth-server). Default: <ITOP_BASE_URL>/env-production/altioo-oauth-server
#ITOP_OAUTH_ISSUER=

# iTop REST API version. Default: 1.3
#ITOP_API_VERSION=1.3

# Maximum number of rows a single tool call fetches from iTop. Default: 50
#MCP_MAX_ROWS=50

# Internal CA: CA bundle (PEM) to verify iTop's HTTPS certificate, as a path INSIDE the container.
# Only needed if iTop's certificate is issued by your own CA. Mount the file read-only with the
# commented example in compose.yaml, then set this to the mount target. The bundle replaces the
# built-in list of public CAs, so it must contain the CA that issued iTop's certificate (root, plus
# intermediates if iTop does not send them). Certificate verification is never turned off.
#SSL_CERT_FILE=/etc/itop-mcp/ca.pem

# --- Docker compose (host side) -----------------------------------------------------------

# Read by docker compose itself, only from this .env file (next to compose.yaml) or the shell.

# Host port, published on 127.0.0.1 only. Point your reverse proxy at it. Default: 8130
#MCP_PUBLISH_PORT=8130

# Host folder for the audit log (JSON lines). Default: ./logs
# On Linux it must be writable by UID 10001 (the container user):
#   mkdir -p logs && sudo chown 10001:10001 logs
#MCP_LOG_DIR=./logs

# --- Inside the container (normally leave alone) -------------------------------------------

# Audit log path inside the container. Default: /data/logs/mcp-itop-audit.log (= MCP_LOG_DIR on
# the host). Anywhere outside /data/logs is read-only and the server refuses to start.
#MCP_AUDIT_LOG=/data/logs/mcp-itop-audit.log

# Fixed by compose.yaml, setting them here has no effect in Docker:
#   MCP_HOST=0.0.0.0   listen address inside the container
#   MCP_PORT=8130      listen port inside the container
# If you run the image without compose, keep MCP_HOST=0.0.0.0: any other value is unsupported in
# the container, because the healthcheck always queries 127.0.0.1:MCP_PORT and the container
# turns unhealthy when the server does not listen there.
# The healthcheck never goes through HTTP_PROXY/HTTPS_PROXY, so a proxy set here for reaching
# iTop needs no NO_PROXY entry for localhost.
