# TEST ONLY. Every key and secret in this file is a test value; never reuse them.

# --- An existing LibreChat install (not part of the manual)
CREDS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CREDS_IV=0123456789abcdef0123456789abcdef
JWT_SECRET=test-jwt-secret-for-the-test-stack-only-0123456789
JWT_REFRESH_SECRET=test-jwt-refresh-secret-for-the-test-stack-only-0123
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false

# --- From docs/setup/example-keycloak-librechat.md, section ".env: log in with Keycloak"
DOMAIN_CLIENT=https://chat.example.com
DOMAIN_SERVER=https://chat.example.com
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
OPENID_ISSUER=https://sso.example.com/realms/example
OPENID_CLIENT_ID=librechat
# Test value, set on the Keycloak client by the setup service.
OPENID_CLIENT_SECRET=test-secret-librechat-client-0123456789
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SESSION_SECRET=test-openid-session-secret-for-the-test-stack-only
OPENID_BUTTON_LABEL=Sign in with Keycloak
OPENID_USE_PKCE=true
